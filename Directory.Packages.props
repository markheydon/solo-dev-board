<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Build -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <!-- Aspire hosting -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.ContainerRegistry" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.1" />
    <!-- Project v2 (AddDotnetProject): stable 13.6.0 not published on NuGet yet; pin preview aligned with AppHost SDK. -->
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="13.6.1-preview.1.26506.6" />
  </ItemGroup>
  <!-- Application and framework services -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>
  <!-- UI -->
  <ItemGroup>
    <!-- When MudBlazor's version changes, refresh .agents/skills/mudblazor/ in the same PR (see SKILL.md baseline). -->
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>
  <!-- Content and serialisation -->
  <ItemGroup>
    <PackageVersion Include="Markdig" Version="1.4.1" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
  <!-- Observability -->
  <ItemGroup>
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="AngleSharp" Version="1.8.6" />
    <PackageVersion Include="Deque.AxeCore.Commons" Version="4.14.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.64.1" />
  </ItemGroup>
</Project>
