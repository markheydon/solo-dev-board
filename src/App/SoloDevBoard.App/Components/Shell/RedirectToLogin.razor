@namespace SoloDevBoard.App.Components.Shell
@using SoloDevBoard.App.Authentication
@inject NavigationManager NavigationManager

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var absoluteUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (absoluteUri.AbsolutePath.Equals("/welcome", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var returnUrl = HostedAuthReturnUrl.GetRequestedReturnUrl(absoluteUri);
        var destination = $"/welcome?returnUrl={Uri.EscapeDataString(returnUrl ?? "/")}";
        NavigationManager.NavigateTo(destination, forceLoad: true);
    }
}
