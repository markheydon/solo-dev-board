@inherits LayoutComponentBase
@namespace SoloDevBoard.App.Components.Shell.Layout

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">SoloDevBoard</MudText>
    </MudAppBar>
    <MudMainContent Class="pt-16 pa-4 d-flex justify-center">
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
