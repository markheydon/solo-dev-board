@namespace SoloDevBoard.App.Components.Shell
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using SoloDevBoard.Infrastructure.GitHub
@inject IOptions<GitHubAuthOptions> GitHubAuthOptionsAccessor

@if (GitHubAuthOptionsAccessor.Value.HostedSignInEnabled)
{
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(global::SoloDevBoard.App.Components.Features.Common.Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(global::SoloDevBoard.App.Components.Shell.Layout.MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1, .mud-typography-h4, .mud-typography-h5" />
            </Found>
        </Router>
    </CascadingAuthenticationState>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(global::SoloDevBoard.App.Components.Features.Common.Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(global::SoloDevBoard.App.Components.Shell.Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1, .mud-typography-h4, .mud-typography-h5" />
        </Found>
    </Router>
}
