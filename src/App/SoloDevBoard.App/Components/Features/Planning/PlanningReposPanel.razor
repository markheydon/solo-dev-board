@using SoloDevBoard.App.Components.Features.Planning
@using SoloDevBoard.Application.Services.Planning
@implements IDisposable

<MudStack Spacing="3" data-testid="planning-repos-page">
    <MudText Typo="Typo.h5">Repo Management</MudText>
    <MudText Typo="Typo.body1">
        Control which repositories feed PM recommendations and set planning thresholds.
        Board occupancy on the selected planning board still counts mapped Issue and Pull Request cards.
    </MudText>

    @if (ChromeState is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Planning chrome is unavailable.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1" data-testid="planning-thresholds-region">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Planning thresholds</MudText>
                <MudText Typo="Typo.body2">
                    Capacity is used for Daily Focus active load. Stall days apply to stalled Up Next and pull requests awaiting review on Daily Focus. Neglect days apply when Backlog ships. Save after editing.
                </MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.End">
                    <MudNumericField @bind-Value="capacity"
                                     Label="Capacity limit"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Immediate="false"
                                     data-testid="planning-capacity-field" />
                    <MudNumericField @bind-Value="stallDays"
                                     Label="Stall days"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Immediate="false"
                                     data-testid="planning-stall-days-field" />
                    <MudNumericField @bind-Value="neglectDays"
                                     Label="Neglect days"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Immediate="false"
                                     data-testid="planning-neglect-days-field" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveThresholdsAsync"
                               data-testid="planning-save-thresholds-button">
                        Save thresholds
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1" data-testid="planning-participation-region">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Repository participation</MudText>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-participation-summary">
                    <strong>@IncludedRepositoryCount included</strong>
                    · <strong>@excludedRepositories.Count excluded</strong>.
                    Every active repository participates in PM queries by default.
                    Remove repositories you do not want in recommendations, backlog, or planning below.
                    Archived repositories are never offered.
                </MudAlert>

                <MudStack Spacing="2" data-testid="planning-included-repositories-region">
                    <MudText Typo="Typo.subtitle1">Included repositories</MudText>
                    <MudText Typo="Typo.body2">
                        These repositories currently participate in PM queries. Select <strong>Exclude</strong> to remove one.
                    </MudText>

                    @if (includedRepositoryOptions.Count == 0)
                    {
                        <MudText Typo="Typo.body2" data-testid="planning-no-included-text">
                            No active repositories are available to include.
                        </MudText>
                    }
                    else
                    {
                        <MudTextField @bind-Value="includedRepositoryFilter"
                                      Label="Filter included repositories"
                                      Placeholder="Type owner/name to narrow the list"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentAriaLabel="Filter included repositories"
                                      Immediate="true"
                                      data-testid="planning-included-filter" />

                        <MudTable T="string"
                                  Items="FilteredIncludedRepositories"
                                  Dense="true"
                                  Hover="true"
                                  Class="sdb-responsive-grid"
                                  data-testid="planning-included-table">
                            <HeaderContent>
                                <MudTh>Repository</MudTh>
                                <MudTh Class="text-end">Participation</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Repository">@context</MudTd>
                                <MudTd DataLabel="Participation" Class="text-end">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => ExcludeRepositoryAsync(context)"
                                               data-testid="planning-row-exclude-button">
                                        Exclude
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>

                <MudDivider />

                <MudStack Spacing="2" data-testid="planning-exclusions-region">
                    <MudText Typo="Typo.subtitle1">Excluded repositories</MudText>
                    <MudText Typo="Typo.body2">
                        Excluded repositories are omitted from Daily Focus recommendations, Backlog Review, and Planning candidates.
                    </MudText>

                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Spacing="2">
                        <MudAutocomplete T="string"
                                         @bind-Value="repositoryToExclude"
                                         Label="Quick exclude"
                                         Placeholder="Search owner/name"
                                         Variant="Variant.Outlined"
                                         SearchFunc="SearchIncludedRepositoriesAsync"
                                         MinCharacters="0"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="true"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         AdornmentAriaLabel="Search repositories to exclude"
                                         Disabled="includedRepositoryOptions.Count == 0"
                                         data-testid="planning-exclude-autocomplete" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="string.IsNullOrWhiteSpace(repositoryToExclude)"
                                   OnClick="() => ExcludeRepositoryAsync(repositoryToExclude)"
                                   data-testid="planning-exclude-button">
                            Exclude
                        </MudButton>
                    </MudStack>

                    @if (excludedRepositories.Count == 0)
                    {
                        <MudText Typo="Typo.body2" data-testid="planning-no-exclusions-text">
                            No repositories are excluded. All active repositories participate.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1" data-testid="planning-excluded-list">
                            @foreach (var repository in excludedRepositories)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@repository</MudChip>
                                    <MudButton Variant="Variant.Text"
                                               OnClick="() => IncludeRepositoryAsync(repository)"
                                               data-testid="planning-include-button">
                                        Include again
                                    </MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1" data-testid="planning-repository-summary-region">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Per-repository summary</MudText>
                <MudText Typo="Typo.body2">
                    Open issue and pull request counts come from the PM work-item catalogue.
                    Excluded repositories are omitted. Included shows whether the repository currently participates in PM queries.
                </MudText>

                @if (isLoadingSummaries)
                {
                    <MudProgressLinear Indeterminate="true" data-testid="planning-repository-summary-loading" />
                }
                else if (!string.IsNullOrWhiteSpace(summaryErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="planning-repository-summary-error">
                        <MudStack Spacing="2">
                            <MudText>@summaryErrorMessage</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="RetryLoadSummariesAsync"
                                       data-testid="planning-repository-summary-retry">
                                Retry
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }
                else
                {
                    @if (summaryFailures.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="planning-repository-summary-partial-failure">
                            <MudStack Spacing="2">
                                <MudText>
                                    Counts are unavailable for @summaryFailures.Count
                                    @(summaryFailures.Count == 1 ? "repository" : "repositories"):
                                    @string.Join(", ", summaryFailures.Select(failure => failure.RepositoryFullName)).
                                    Failed repositories are omitted from the table.
                                </MudText>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="RetryLoadSummariesAsync"
                                           data-testid="planning-repository-summary-partial-retry">
                                    Retry
                                </MudButton>
                            </MudStack>
                        </MudAlert>
                    }

                    @if (repositorySummaries.Count == 0)
                    {
                        <MudText Typo="Typo.body2" data-testid="planning-repository-summary-empty">
                            No included repositories are available to summarise.
                        </MudText>
                    }
                    else
                    {
                        <MudTable T="PlanningRepositorySummaryDto"
                                  Items="repositorySummaries"
                                  Dense="true"
                                  Hover="true"
                                  Breakpoint="Breakpoint.Sm"
                                  Class="sdb-responsive-grid"
                                  data-testid="planning-repository-summary-table">
                            <HeaderContent>
                                <MudTh>Repository</MudTh>
                                <MudTh>Open issues</MudTh>
                                <MudTh>Open PRs</MudTh>
                                <MudTh>Last activity</MudTh>
                                <MudTh>Included</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Repository">@context.FullName</MudTd>
                                <MudTd DataLabel="Open issues">@context.OpenIssueCount</MudTd>
                                <MudTd DataLabel="Open PRs">@context.OpenPullRequestCount</MudTd>
                                <MudTd DataLabel="Last activity">@FormatLastActivity(context.LastActivityAt)</MudTd>
                                <MudTd DataLabel="Included">@(context.IsIncluded ? "Yes" : "No")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>
