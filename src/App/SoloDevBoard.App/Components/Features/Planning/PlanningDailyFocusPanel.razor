@using SoloDevBoard.App.Components.Features.Planning
@using SoloDevBoard.Application.Services.Planning

<MudStack Spacing="3" data-testid="planning-daily-focus-page">
    <MudText Typo="Typo.h5">Daily Focus</MudText>
    <MudText Typo="Typo.body1">
        Occupancy and active load are for the selected planning board. Recommended today ranks unblocked work from all included repositories by default, or from the selected planning board when you turn on the option below. Stalled Up Next items are shown when they exceed the stall threshold. Pull requests awaiting review for @stallDaysThreshold or more days are listed below.
    </MudText>

    @if (ChromeState is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Planning chrome is unavailable.</MudAlert>
    }
    else if (!ChromeState.IsLoading && !string.IsNullOrWhiteSpace(ChromeState.LoadErrorMessage))
    {
        @* Chrome already shows the error and retry. *@
    }
    else if (ChromeState.IsLoading)
    {
        <MudText Typo="Typo.body2" data-testid="planning-daily-focus-loading">
            Loading planning boards, occupancy, and recommendations.
        </MudText>
    }
    else if (!ChromeState.HasPlanningBoardSelected)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-no-board">
            Select a planning board in the dropdown above to load Daily Focus occupancy and recommendations.
        </MudAlert>
    }
    else
    {
        @if (isLoadingBoardState || isLoadingRecommendations || isLoadingStalledReviews)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@DailyFocusLoadingAriaLabel" />
        }

        @if (!string.IsNullOrWhiteSpace(loadErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="planning-daily-focus-error">
                @loadErrorMessage
                <MudButton Variant="Variant.Text"
                           OnClick="RetryLoadBoardStateAsync"
                           data-testid="planning-daily-focus-retry">Retry</MudButton>
            </MudAlert>
        }
        else if (!isLoadingBoardState && boardState is not null)
        {
            <MudPaper Class="pa-4" Elevation="1" data-testid="planning-daily-focus-board-state">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Board state</MudText>
                    @if (boardState.Occupancy.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-empty">
                            This planning board has no Status options and no items yet.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" aria-live="polite">
                            @foreach (var chip in boardState.Occupancy)
                            {
                                <MudChip T="string"
                                         Value="@chip.StatusName"
                                         Variant="Variant.Outlined"
                                         Color="Color.Default"
                                         data-testid="planning-occupancy-chip">
                                    @($"{chip.StatusName} {chip.Count}")
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudText Typo="Typo.body1" aria-live="polite" data-testid="planning-active-load">
                        Active load: @boardState.ActiveLoad / @boardState.Capacity (Up Next + In Progress)
                    </MudText>

                    <MudStack Spacing="2" data-testid="planning-daily-focus-stalled">
                        <MudText Typo="Typo.h6">Stalled</MudText>
                        <MudText Typo="Typo.body2">Up Next @boardState.StallDays+ days</MudText>
                        @if (boardState.StalledUpNextItems.Count == 0)
                        {
                            <MudText Typo="Typo.body2" data-testid="planning-daily-focus-none-stalled">
                                No Up Next items have been stalled for @boardState.StallDays or more days.
                            </MudText>
                        }
                        else
                        {
                            <MudStack Spacing="1" aria-live="polite">
                                @foreach (var stalled in boardState.StalledUpNextItems)
                                {
                                    <MudStack Row="true"
                                              Wrap="Wrap.Wrap"
                                              AlignItems="AlignItems.Center"
                                              Spacing="2"
                                              data-testid="planning-stalled-row">
                                        <MudText Typo="Typo.body1">@stalled.Title</MudText>
                                        <MudText Typo="Typo.body2">@($"({stalled.AgeInDays}d)")</MudText>
                                        <MudLink Href="@stalled.Url"
                                                 Target="_blank"
                                                 rel="noopener noreferrer"
                                                 aria-label="@($"Open {stalled.Title} on GitHub")"
                                                 data-testid="planning-stalled-github-link">
                                            Open
                                        </MudLink>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        @if (boardState.StalledUpNextItems.Any(static item => item.UsedUpdatedAtFallback))
                        {
                            <MudText Typo="Typo.caption" data-testid="planning-stalled-footnote">
                                Age uses the item last-updated time because Status-changed-at was not available.
                            </MudText>
                        }
                    </MudStack>

                    @if (boardState.ItemCount == 0 && boardState.Occupancy.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-empty-board">
                            This planning board has no items.
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (!string.IsNullOrWhiteSpace(recommendationsErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="planning-daily-focus-recommendations-error">
                @recommendationsErrorMessage
                <MudButton Variant="Variant.Text"
                           OnClick="RetryLoadRecommendationsAsync"
                           data-testid="planning-daily-focus-recommendations-retry">Retry</MudButton>
            </MudAlert>
        }
        else if (!isLoadingRecommendations && recommendations is not null)
        {
            @if (!string.IsNullOrWhiteSpace(recommendationsWarningMessage))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="planning-daily-focus-recommendations-warning">
                    @recommendationsWarningMessage
                    <MudButton Variant="Variant.Text"
                               OnClick="RetryLoadRecommendationsAsync"
                               data-testid="planning-daily-focus-recommendations-retry">Retry</MudButton>
                </MudAlert>
            }

            <MudPaper Class="pa-4" Elevation="1" data-testid="planning-daily-focus-recommendations">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">@RecommendationsHeading</MudText>
                    <MudSwitch T="bool"
                               Value="limitRecommendationsToPlanningBoard"
                               ValueChanged="ToggleRecommendationsScopeAsync"
                               Color="Color.Primary"
                               data-testid="planning-limit-recommendations-switch">
                        Limit Recommended today to the selected planning board
                    </MudSwitch>
                    <MudText Typo="Typo.body2" data-testid="planning-limit-recommendations-help">
                        Board occupancy and active load always use the selected planning board. This option only changes which items are eligible for Recommended today.
                    </MudText>
                    @if (ShowRecommendationsShortfall)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-recommendations-shortfall">
                            Only @recommendations!.Count eligible @(recommendations.Count == 1 ? "item" : "items") on the planning board. Recommendations are not backfilled from other repositories.
                        </MudAlert>
                    }
                    @if (recommendations.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-recommendations-empty">
                            No unblocked work items to recommend today.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" data-testid="planning-daily-focus-recommendations-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Priority</th>
                                    <th>Item</th>
                                    <th>Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var recommendation in recommendations)
                                {
                                    <tr data-testid="planning-daily-focus-recommendation-row">
                                        <td>@recommendation.Rank</td>
                                        <td>
                                            <MudChip T="string"
                                                     Value="@FormatPriorityChip(recommendation.PriorityLabel)"
                                                     Variant="Variant.Outlined"
                                                     Color="Color.Default"
                                                     data-testid="planning-recommendation-priority-chip">
                                                @FormatPriorityChip(recommendation.PriorityLabel)
                                            </MudChip>
                                        </td>
                                        <td>
                                            <MudLink Href="@recommendation.HtmlUrl"
                                                     Target="_blank"
                                                     rel="noopener noreferrer"
                                                     data-testid="planning-recommendation-link">
                                                @FormatItemReference(recommendation)
                                            </MudLink>
                                        </td>
                                        <td>@recommendation.Title</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (!string.IsNullOrWhiteSpace(stalledReviewsErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="planning-daily-focus-stalled-reviews-error">
                @stalledReviewsErrorMessage
                <MudButton Variant="Variant.Text"
                           OnClick="RetryLoadStalledReviewsAsync"
                           data-testid="planning-daily-focus-stalled-reviews-retry">Retry</MudButton>
            </MudAlert>
        }
        else if (!isLoadingStalledReviews && stalledReviews is not null)
        {
            <MudPaper Class="pa-4" Elevation="1" data-testid="planning-daily-focus-stalled-reviews">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Stalled</MudText>
                    <MudText Typo="Typo.subtitle2">
                        PRs awaiting review @stallDaysThreshold+ days
                    </MudText>
                    @if (stalledReviews.Items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="planning-daily-focus-stalled-reviews-empty">
                            No pull requests have been awaiting review for @stallDaysThreshold or more days.
                        </MudAlert>
                    }
                    else
                    {
                        <MudList T="DailyFocusStalledReviewPullRequestDto" data-testid="planning-daily-focus-stalled-reviews-list">
                            @foreach (var pullRequest in stalledReviews.Items)
                            {
                                <MudListItem T="DailyFocusStalledReviewPullRequestDto" data-testid="planning-stalled-review-row">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                        <MudText Typo="Typo.body1">
                                            @pullRequest.RepositoryFullName#@pullRequest.Number
                                        </MudText>
                                        <MudText Typo="Typo.body2">@($"({pullRequest.AgeDays}d)")</MudText>
                                        <MudLink Href="@pullRequest.HtmlUrl"
                                                 Target="_blank"
                                                 rel="noopener noreferrer">Open</MudLink>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>
