@using SoloDevBoard.App.Components.Features.PmWorkflow
@using SoloDevBoard.Application.Services.PmWorkflow

<MudStack Spacing="3" data-testid="pm-workflow-board-setup-page">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudText Typo="Typo.h5">Board setup</MudText>
        @if (ChromeState?.HasPlanningBoardSelected == true)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Sync"
                       Disabled="ChromeState.IsLoadingBoardCompatibility"
                       OnClick="RecheckAsync"
                       data-testid="pm-workflow-board-setup-recheck">
                Recheck
            </MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.body1">
        Planning expects specific Status columns and fields on the selected project board.
        Fix the items below in GitHub Projects, then select <strong>Recheck</strong> to confirm the board is ready.
    </MudText>

    @if (ChromeState is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Planning chrome is unavailable.</MudAlert>
    }
    else if (!ChromeState.HasPlanningBoardSelected)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="pm-workflow-board-setup-no-board">
            Select a planning board in the dropdown above to review board setup.
        </MudAlert>
    }
    else if (ChromeState.IsLoadingBoardCompatibility)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" aria-label="Checking board setup" />
    }
    else if (ChromeState.BoardCompatibilityReport is { HasIssues: false })
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" data-testid="pm-workflow-board-setup-ok">
            The selected planning board exposes the Status columns and fields Planning expects.
        </MudAlert>
    }
    else if (ChromeState.BoardCompatibilityReport is { HasIssues: true } report)
    {
        <MudExpansionPanels MultiExpansion="true" data-testid="pm-workflow-board-setup-panels">
            @if (report.Issues.Any(issue => issue.Severity == PlanningBoardCompatibilitySeverity.Error))
            {
                <MudExpansionPanel Text="Required fixes"
                                   Icon="@Icons.Material.Filled.ErrorOutline"
                                   Expanded="true"
                                   data-testid="pm-workflow-board-setup-errors-panel">
                    <MudStack Spacing="2">
                        @foreach (var issue in report.Issues.Where(issue => issue.Severity == PlanningBoardCompatibilitySeverity.Error))
                        {
                            <MudAlert Severity="Severity.Error"
                                      Variant="Variant.Outlined"
                                      Dense="true"
                                      data-testid="pm-workflow-board-setup-issue">
                                <MudText Typo="Typo.subtitle2">@issue.Title</MudText>
                                <MudText Typo="Typo.body2">@issue.Detail</MudText>
                            </MudAlert>
                        }
                    </MudStack>
                </MudExpansionPanel>
            }

            @if (report.Issues.Any(issue => issue.Severity == PlanningBoardCompatibilitySeverity.Warning))
            {
                <MudExpansionPanel Text="Recommended improvements"
                                   Icon="@Icons.Material.Filled.WarningAmber"
                                   data-testid="pm-workflow-board-setup-warnings-panel">
                    <MudStack Spacing="2">
                        @foreach (var issue in report.Issues.Where(issue => issue.Severity == PlanningBoardCompatibilitySeverity.Warning))
                        {
                            <MudAlert Severity="Severity.Warning"
                                      Variant="Variant.Outlined"
                                      Dense="true"
                                      data-testid="pm-workflow-board-setup-issue">
                                <MudText Typo="Typo.subtitle2">@issue.Title</MudText>
                                <MudText Typo="Typo.body2">@issue.Detail</MudText>
                            </MudAlert>
                        }
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>
