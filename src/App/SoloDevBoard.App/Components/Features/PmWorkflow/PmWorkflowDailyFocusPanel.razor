@using SoloDevBoard.App.Components.Features.PmWorkflow
@using SoloDevBoard.Application.Services.PmWorkflow

<MudStack Spacing="3" data-testid="pm-workflow-daily-focus-page">
    <MudText Typo="Typo.h5">Daily Focus</MudText>
    <MudText Typo="Typo.body1">
        Occupancy and active load are for the selected planning board. Recommended today is the top three unblocked items from all included repositories.
        Stalled Up Next items and stalled review pull requests will appear here in later stories.
    </MudText>

    @if (ChromeState is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">PM Workflow chrome is unavailable.</MudAlert>
    }
    else if (!ChromeState.IsLoading && !string.IsNullOrWhiteSpace(ChromeState.LoadErrorMessage))
    {
        @* Chrome already shows the error and retry. *@
    }
    else if (ChromeState.IsLoading)
    {
        <MudText Typo="Typo.body2" data-testid="pm-workflow-daily-focus-loading">
            Loading planning boards, occupancy, and recommendations.
        </MudText>
    }
    else if (!ChromeState.HasPlanningBoardSelected)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-no-board">
            Select a planning board in the dropdown above to load Daily Focus occupancy and recommendations.
        </MudAlert>
    }
    else
    {
        @if (isLoadingBoardState || isLoadingRecommendations)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@DailyFocusLoadingAriaLabel" />
        }

        @if (!string.IsNullOrWhiteSpace(loadErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-error">
                @loadErrorMessage
                <MudButton Variant="Variant.Text"
                           OnClick="RetryLoadBoardStateAsync"
                           data-testid="pm-workflow-daily-focus-retry">Retry</MudButton>
            </MudAlert>
        }
        else if (!isLoadingBoardState && boardState is not null)
        {
            <MudPaper Class="pa-4" Elevation="1" data-testid="pm-workflow-daily-focus-board-state">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Board state</MudText>
                    @if (boardState.Occupancy.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-empty">
                            This planning board has no Status options and no items yet.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" aria-live="polite">
                            @foreach (var chip in boardState.Occupancy)
                            {
                                <MudChip T="string"
                                         Value="@chip.StatusName"
                                         Variant="Variant.Outlined"
                                         Color="Color.Default"
                                         data-testid="pm-workflow-occupancy-chip">
                                    @($"{chip.StatusName} {chip.Count}")
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudText Typo="Typo.body1" aria-live="polite" data-testid="pm-workflow-active-load">
                        Active load: @boardState.ActiveLoad / @boardState.Capacity (Up Next + In Progress)
                    </MudText>

                    @if (boardState.ItemCount == 0 && boardState.Occupancy.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-empty-board">
                            This planning board has no items.
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (!string.IsNullOrWhiteSpace(recommendationsErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-recommendations-error">
                @recommendationsErrorMessage
                <MudButton Variant="Variant.Text"
                           OnClick="RetryLoadRecommendationsAsync"
                           data-testid="pm-workflow-daily-focus-recommendations-retry">Retry</MudButton>
            </MudAlert>
        }
        else if (!isLoadingRecommendations && recommendations is not null)
        {
            @if (!string.IsNullOrWhiteSpace(recommendationsWarningMessage))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-recommendations-warning">
                    @recommendationsWarningMessage
                    <MudButton Variant="Variant.Text"
                               OnClick="RetryLoadRecommendationsAsync"
                               data-testid="pm-workflow-daily-focus-recommendations-retry">Retry</MudButton>
                </MudAlert>
            }

            <MudPaper Class="pa-4" Elevation="1" data-testid="pm-workflow-daily-focus-recommendations">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Recommended today (all included repositories)</MudText>
                    @if (recommendations.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="pm-workflow-daily-focus-recommendations-empty">
                            No unblocked work items to recommend today.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" data-testid="pm-workflow-daily-focus-recommendations-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Priority</th>
                                    <th>Item</th>
                                    <th>Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var recommendation in recommendations)
                                {
                                    <tr data-testid="pm-workflow-daily-focus-recommendation-row">
                                        <td>@recommendation.Rank</td>
                                        <td>
                                            <MudChip T="string"
                                                     Value="@FormatPriorityChip(recommendation.PriorityLabel)"
                                                     Variant="Variant.Outlined"
                                                     Color="Color.Default"
                                                     data-testid="pm-workflow-recommendation-priority-chip">
                                                @FormatPriorityChip(recommendation.PriorityLabel)
                                            </MudChip>
                                        </td>
                                        <td>
                                            <MudLink Href="@recommendation.HtmlUrl"
                                                     Target="_blank"
                                                     rel="noopener noreferrer"
                                                     data-testid="pm-workflow-recommendation-link">
                                                @FormatItemReference(recommendation)
                                            </MudLink>
                                        </td>
                                        <td>@recommendation.Title</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>
