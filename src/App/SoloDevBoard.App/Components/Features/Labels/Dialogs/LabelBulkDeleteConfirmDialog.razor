<MudDialog data-testid="bulk-delete-confirm-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Are you sure?</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body1">Delete the selected labels from the repositories listed below. Labels are removed only where they are present.</MudText>

        <MudText Typo="Typo.subtitle2" Class="mt-3">Labels to delete</MudText>
        <MudList T="string" Dense="true" data-testid="bulk-delete-label-list">
            @foreach (var target in Content.Targets)
            {
                <MudListItem T="string">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2">@target.LabelName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @FormatRepositoryList(target.RepositoryFullNames)
                        </MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="CancelAsync"
                   data-testid="bulk-delete-cancel-button">
            No
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="ConfirmAsync"
                   data-testid="bulk-delete-confirm-button">
            Yes, delete
        </MudButton>
    </DialogActions>
</MudDialog>
