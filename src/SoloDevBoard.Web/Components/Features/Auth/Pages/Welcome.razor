@page "/welcome"
@layout LandingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using SoloDevBoard.Application.Services.Common

<PageTitle>Welcome - @ProductBranding.DisplayName</PageTitle>

<MudStack Spacing="4" AlignItems="AlignItems.Center" Class="text-center">
    <BrandMark Size="72" />
    <MudText Typo="Typo.h4" data-testid="welcome-product-name">@ProductBranding.DisplayName</MudText>
    <MudText Typo="Typo.body1">
        Your single pane of glass for GitHub workloads.
    </MudText>
    <MudText Typo="Typo.body2">
        Sign in with your GitHub account to access this deployment.
        Access is limited to operator-approved users and organisations.
    </MudText>
    <MudButton Href="@_signInUrl"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Login"
               data-testid="welcome-sign-in">
        Sign in with GitHub
    </MudButton>
</MudStack>
